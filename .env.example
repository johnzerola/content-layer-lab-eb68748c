# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ChatScene / ElevenLabs (server only)
# The user's ElevenLabs key is entered in Contas e credenciais and stored
# encrypted per account. Do not add a shared ElevenLabs key to the browser env.
# Run the ai_provider_credentials migration before enabling this integration.

# Supabase (browser-safe public configuration)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# ChatScene TTS (configure one server-side key; Lovable takes precedence)
LOVABLE_API_KEY=
OPENAI_API_KEY=

# Editor V2 permanece desligado por padrão. No cliente Vite use esta variante;
# no servidor, EDITOR_V2_ENABLED segue o mesmo valor.
VITE_EDITOR_V2_ENABLED=false
EDITOR_V2_ENABLED=false

# Protected publishing dispatcher (server only, minimum 32 characters)
PUBLISH_CRON_SECRET=
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_LOCK_TIMEOUT_SECONDS=900

# Existing server-side Instagram providers
AYRSHARE_API_KEY=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=

# Future official OAuth applications (server only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# O modo clássico é o padrão. Use business somente com uma configuração
# publicada que contenha todos os scopes obrigatórios do projeto.
META_LOGIN_MODE=classic
META_LOGIN_CONFIG_ID=
SOCIAL_TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_SITE_URL=
# YouTube Data API v3 (OAuth 2.0 Google Cloud) — server only
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Opcional; por padrão usa PUBLIC_SITE_URL + /integracoes/youtube/callback
YOUTUBE_REDIRECT_URI=
# Opcional: public, unlisted ou private. Padrao: public.
YOUTUBE_PRIVACY_STATUS=public

# CleanerIA — worker GPU (server only)
# URL HTTPS do worker (RunPod Load Balancer: https://<endpoint-id>.api.runpod.ai)
CLEANER_WORKER_URL=
CLEANER_WORKER_PUBLIC_URL=
# Segredo HMAC compartilhado com o worker (mínimo 32 caracteres)
CLEANER_WORKER_SECRET=
# RunPod Serverless modo fila (orquestração de chunks — opcional)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
CHATSCENE_VOICE_PYTHON_PATH=
CHATSCENE_VOICE_MODEL_PATH=
CHATSCENE_VOICE_STORAGE_PATH=
CHATSCENE_VOICE_DEVICE=auto
CHATSCENE_VOICE_READY=false
CHATSCENE_VOICE_CONFIG=
FFMPEG_PATH=
CHATSCENE_GPU_RELAY_URL=
CHATSCENE_GPU_RELAY_TOKEN=
CHATSCENE_GPU_BIND=127.0.0.1
CHATSCENE_GPU_PORT=18096
CHATSCENE_VOICE_SERVICE_URL=
CHATSCENE_VOICE_SERVICE_SECRET=
