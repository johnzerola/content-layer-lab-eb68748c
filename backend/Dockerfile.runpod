# CleanerIA — worker serverless RunPod (um chunk por invocação)
#
# Build: docker build -f Dockerfile.runpod -t cleaner-runpod .
# Deploy: RunPod > Serverless > Custom image, com um Network Volume montado em
#         /runpod-volume contendo os pesos (ProPainter / DiffuEraser).
#
# Variáveis relevantes:
#   PROPAINTER_WEIGHTS_DIR=/runpod-volume/models
#   DIFFUERASER_MODELS_ROOT=/runpod-volume/max-models
#   CLEANER_WORKER_SECRET=<segredo compartilhado com o app>

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    TORCH_CUDA_ARCH_LIST="7.0 7.5 8.0 8.6 8.9 9.0" \
    CLEANER_ENV=production \
    CLEANER_STORAGE=/app/storage \
    USE_CELERY=0 \
    PROPAINTER_ROOT=/opt/ProPainter \
    PROPAINTER_WEIGHTS_DIR=/runpod-volume/models \
    PROPAINTER_MAX_SIDE=896 \
    DIFFUERASER_ROOT=/opt/DiffuEraser \
    DIFFUERASER_MODELS_ROOT=/runpod-volume/max-models \
    DIFFUERASER_MAX_SIDE=960 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HOME=/tmp/huggingface \
    OMP_NUM_THREADS=4

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip python3.10-venv \
    ffmpeg tini \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 \
    git wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN python3.10 -m pip install --upgrade pip setuptools wheel && \
    python3.10 -m pip install -r requirements.txt && \
    python3.10 -m pip install runpod==1.7.7

ARG PROPAINTER_COMMIT=e870e79321c31b733e2031af5aa2fb1fe3ac7eec
RUN git clone --no-checkout https://github.com/sczhou/ProPainter.git /opt/ProPainter && \
    cd /opt/ProPainter && git checkout ${PROPAINTER_COMMIT}

ARG DIFFUERASER_COMMIT=8e6f279ac7531e27ad1849c6f8dab5372a8597e7
RUN git clone --no-checkout https://github.com/lixiaowen-xw/DiffuEraser.git /opt/DiffuEraser && \
    cd /opt/DiffuEraser && git checkout ${DIFFUERASER_COMMIT}

COPY app/ ./app/
COPY runpod_handler.py ./runpod_handler.py

RUN mkdir -p /app/storage

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3.10", "-u", "runpod_handler.py"]
